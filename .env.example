# LineUp backend environment. Copy to .env for local development (never commit .env).
# Every variable is optional; the API runs with mock fallbacks when a key is missing.

# --- Runtime ---------------------------------------------------------------
FLASK_ENV=development            # development | production | testing. Dev enables debug + mock seed data.
                                 # (ENV is read as a fallback when FLASK_ENV is unset.)
LINEUP_BARBER_SIDE=false         # true switches on barber accounts, bookings, portfolios/packages and the community
                                 # feed (API only; the shipped frontend is consumer-only). Off for the consumer launch.
LINEUP_ALLOW_MEMORY_STORE=false  # Production refuses to start without FIREBASE_CREDENTIALS (credits would vanish on
                                 # restart). true allows the in-memory store for a throwaway demo deploy only.
PORT=5000                        # Port for `python app.py` (Render sets this automatically).
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR. DEBUG also logs each request.
LOG_FORMAT=text                  # text | json (one JSON object per line for log aggregation).
LINEUP_TRUST_PROXY=false         # true when behind a reverse proxy (Render) so client IPs/HTTPS are read from X-Forwarded-*.
LINEUP_PUBLIC_URL=               # Public base URL of this API (e.g. https://lineup-fjpn.onrender.com); used for photo links. Defaults to the request host.
LINEUP_FRONTEND_URL=https://lineupai.onrender.com   # Frontend origin; Stripe Checkout/portal redirect back to <url>/#/account.
LINEUP_ALLOWED_ORIGINS=          # Comma-separated CORS origins (exact or regex). Default: prod URLs + any localhost/127.0.0.1 port.
MAX_CONTENT_LENGTH=12582912      # Max request body in bytes (base64 image uploads). Larger bodies get a JSON 413.

# --- Rate limiting -----------------------------------------------------------
RATELIMIT_ENABLED=true           # Set false to disable limits (tests/local).
RATELIMIT_STORAGE_URI=memory://  # memory:// (default) or redis://host:6379 for multi-instance deployments.
# Per-group limits in Flask-Limiter syntax ("N per second|minute|hour|day"). Defaults shown.
LINEUP_RATE_GLOBAL=1000 per hour        # Default for every route.
LINEUP_RATE_HEALTH=200 per minute       # /, /health, /config, /billing/pricing
LINEUP_RATE_READ=200 per hour           # list/get endpoints
LINEUP_RATE_WRITE=60 per hour           # create/update endpoints
LINEUP_RATE_ENGAGEMENT=100 per hour     # likes, comments, shares, follows
LINEUP_RATE_SOCIAL_WRITE=20 per hour    # creating feed posts (upload + moderation)
LINEUP_RATE_AI=10 per hour              # /analyze (Gemini)
LINEUP_RATE_TRYON=20 per hour           # /virtual-tryon (Replicate)
LINEUP_RATE_PLACES=50 per hour          # /barbers search (Google Places)
LINEUP_RATE_OPS=10 per hour             # /metrics, /cache-stats, /clear-cache
LINEUP_RATE_AUTH=30 per hour            # /auth/dev-login, /auth/onboarding
LINEUP_RATE_BILLING=60 per hour         # /billing/checkout, /billing/portal, dev grants
LINEUP_RATE_WEBHOOK=600 per hour        # /billing/webhook
# Limits are keyed by user id when a valid token is sent, otherwise by client IP.

# --- Gemini (photo analysis, image moderation, haircut matching) ------------
GEMINI_API_KEY=                  # From Google AI Studio. Absent -> /analyze returns mock data with "mock": true.
GEMINI_MODEL=gemini-2.0-flash    # Model name.
LINEUP_GEMINI_DAILY_LIMIT=50     # Max Gemini calls per day before falling back to mock data (0 = unlimited).

# --- Google Places (barber search, reviews, photos) --------------------------
GOOGLE_PLACES_API_KEY=           # Absent -> /barbers returns sample barbershops with "mock": true.
LINEUP_PLACES_DAILY_LIMIT=1700   # Max Google Places API calls per day (0 = unlimited).
                                 # One search costs up to 17 calls (geocode +
                                 # nearby + one details call per shop), so this
                                 # is roughly 100 searches.
LINEUP_PLACES_CACHE_TTL=3600     # Seconds to cache search results per location.
LINEUP_PLACES_CACHE_MAX=50       # Max cached locations.

# --- Replicate (virtual try-on) --------------------------------------------
REPLICATE_API_TOKEN=             # Absent -> /virtual-tryon returns a labelled preview of the photo ("mode": "preview").

# --- Image storage for community posts (optional) ----------------------------
CLOUDINARY_CLOUD_NAME=           # All three required to enable Cloudinary uploads; otherwise base64 is stored.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Persistence -------------------------------------------------------------
FIREBASE_CREDENTIALS=            # Firebase service-account JSON (single line). Absent -> in-memory storage AND dev auth mode.
                                 # Required in production unless LINEUP_ALLOW_MEMORY_STORE=true.
LINEUP_SEED_MOCK_DATA=           # true/false. Default: seed demo content only when FLASK_ENV=development and no Firestore.

# --- Auth ----------------------------------------------------------------------
# Mode is derived: FIREBASE_CREDENTIALS set -> "firebase" (ID tokens verified with the Admin SDK);
# otherwise "dev" in development/testing (POST /auth/dev-login issues HS256 JWTs) and "disabled" in production.
FIREBASE_WEB_CONFIG=             # Public web-app config JSON from the Firebase console: {"apiKey":..,"authDomain":..,"projectId":..,"appId":..}. Served by GET /config.
# Shared secret for the operational endpoints (/metrics, /cache-stats, /clear-cache).
# Send it as X-Admin-Token. Without it they answer only in development (dev auth mode).
LINEUP_ADMIN_TOKEN=

LINEUP_DEV_SECRET=               # Secret for dev-login JWTs. Random per process when unset (tokens die on restart); set it to keep sessions across restarts.
LINEUP_DEV_TOKEN_TTL=604800      # Dev token lifetime in seconds (7 days).

# --- Billing (Stripe) and metering ---------------------------------------------
STRIPE_SECRET_KEY=               # sk_test_... / sk_live_... Absent -> /billing/checkout and /billing/portal return 503 stripe_not_configured.
STRIPE_WEBHOOK_SECRET=           # whsec_... from the Stripe webhook endpoint (events: checkout.session.completed, invoice.paid, customer.subscription.updated|deleted).
STRIPE_PRICE_STARTER=            # price_... for the 10-credit pack ($4.99, one-time).
STRIPE_PRICE_PLUS=               # price_... for the 30-credit pack ($9.99, one-time).
STRIPE_PRICE_STUDIO=             # price_... for the 100-credit pack ($24.99, one-time).
STRIPE_PRICE_BARBER_PRO=         # price_... for Barber Pro ($19/month, recurring). Only used with LINEUP_BARBER_SIDE=true.
MAX_ANALYSIS_PER_DAY_PER_USER=20 # Per-user daily caps on metered actions (0 = unlimited), enforced in addition to credits.
MAX_TRYON_PER_DAY_PER_USER=10
MAX_BARBER_SEARCH_PER_DAY_PER_USER=40
LINEUP_METER_MOCK=               # true/false. Charge credits for mock/preview responses? Default: true outside production (so the credit flow can be demoed), false in production.
