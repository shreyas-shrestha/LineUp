# Paths Render leaves out of the published static site (lineup-frontend).
# Build inputs (package.json, package-lock.json, tailwind.config.js, src/) are
# deliberately NOT listed: the build command runs `npm ci && npm run build`.
# The backend service ignores this file.

# Python (the API is a separate service)
.venv/
venv/
env/
ENV/
__pycache__/
*.py
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
build/
dist/
.pytest_cache/
.coverage
htmlcov/
requirements.txt
requirements-dev.txt
Procfile
lineup_backend/
tests/
scripts/

# Development-only files
.context/
src/tools/
.git/
.gitignore
.DS_Store
*.log
node_modules/
.static
static-build.sh

# Docs and configuration
*.md
render.yaml
.env
.env.example
.env.local
.env.*.local
